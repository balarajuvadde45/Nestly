generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum VendorType {
  HOME_COOK
  CLOUD_KITCHEN
  HOME_BUSINESS
  BOUTIQUE
  FOOD_OUTLET
  PICKLES_AND_PACKAGED_FOOD
  SWEETS_SNACKS
  FMCG_DISTRIBUTOR
  HANDMADE_PRODUCTS
}

enum ProductType {
  FOOD
  PICKLE
  CLOTHES
  SNACK
  SWEET
  GROCERY
  FMCG
  PERSONAL_CARE
  HOME_CARE
  BEVERAGE
  READY_TO_COOK
  SAREE
  ACCESSORY
  OTHER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  COD
  WALLET
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  avatarUrl    String?
  googleId     String?   @unique
  authProvider String    @default("email") // email | phone | google
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]   @relation("CustomerOrders")
  vendor       Vendor?
  favorites    Favorite[]

  @@index([phone])
  @@index([email])
}

model Address {
  id          String  @id @default(uuid())
  userId      String
  label       String
  fullAddress String
  area        String
  city        String
  pincode     String
  landmark    String?
  lat         Float?
  lng         Float?
  isDefault   Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model ShopCategory {
  id          String @id
  name        String
  description String
  iconKey     String
  colorHex    String
  imageUrl    String
  vendorCount Int    @default(0)
  sortOrder   Int    @default(0)

  products Product[]
}

model Vendor {
  id               String     @id @default(uuid())
  ownerId          String?    @unique
  name             String
  tagline          String
  description      String
  imageUrl         String
  coverUrl         String
  type             VendorType
  rating           Float      @default(0)
  reviewCount      Int        @default(0)
  deliveryTimeMins Int        @default(40)
  distanceKm       Float      @default(2.0)
  area             String
  city             String     @default("Hyderabad")
  businessAddress  String?
  pincode          String?
  premisesType     String     @default("BUSINESS_PLACE")
  supportPhone     String?
  supportEmail     String?
  gstin            String?
  pan              String?
  fssaiLicense     String?
  fssaiExpiry      DateTime?
  kycStatus        String     @default("PENDING") // PENDING | VERIFIED | REJECTED
  bankAccountLast4 String?
  bankVerified     Boolean    @default(false)
  fulfillmentModesJson String @default("[\"LOCAL_DELIVERY\"]")
  serviceRadiusKm  Float      @default(5)
  gstInvoiceAvailable Boolean @default(false)
  acceptsWholesale Boolean    @default(false)
  categoriesJson   String     @default("[]")
  tagsJson         String     @default("[]")
  isOpen           Boolean    @default(true)
  isPureVeg        Boolean    @default(false)
  freeDelivery     Boolean    @default(false)
  minOrder         Float?
  offerText        String?
  orderCount       Int        @default(0)
  lat              Float      @default(17.4486)
  lng              Float      @default(78.3908)
  isApproved       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  owner    User?     @relation(fields: [ownerId], references: [id])
  products Product[]
  orders   Order[]

  @@index([isApproved, city])
  @@index([type, city])
  @@index([acceptsWholesale, city])
  @@index([name])
  @@index([orderCount])
  @@index([rating])
}

model Product {
  id           String      @id @default(uuid())
  vendorId     String
  categoryId   String?
  name         String
  description  String
  price        Float
  mrp          Float?
  brandName    String?
  sku          String?
  unitLabel    String?
  minOrderQuantity Int @default(1)
  casePackQuantity Int?
  maxOrderQuantity Int?
  stockQuantity    Int?
  hsnCode      String?
  gstRate      Float?
  batchNumber  String?
  manufactureDate DateTime?
  expiryDate   DateTime?
  shelfLifeDays Int?
  manufacturerName String?
  packerName   String?
  originCountry String? @default("India")
  fssaiLicense String?
  isReturnable Boolean @default(false)
  returnWindowDays Int?
  madeToOrder  Boolean @default(false)
  dispatchTimeDays Int?
  wholesaleTiersJson String @default("[]")
  colorsJson   String @default("[]")
  material     String?
  imageUrl     String
  type         ProductType @default(FOOD)
  isVeg        Boolean     @default(true)
  isAvailable  Boolean     @default(true)
  rating       Float       @default(0)
  reviewCount  Int         @default(0)
  tagsJson     String      @default("[]")
  prepTimeMins Int?
  sizesJson    String      @default("[]")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category ShopCategory? @relation(fields: [categoryId], references: [id])
  items    OrderItem[]
  favorites Favorite[]

  @@index([isAvailable, name])
  @@index([vendorId, isAvailable])
  @@index([categoryId])
  @@index([type, isAvailable])
  @@index([sku])
  @@index([brandName])
  @@index([reviewCount])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  vendorId  String?
  productId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@unique([userId, productId])
}

model Order {
  id                String        @id @default(uuid())
  customerId        String
  vendorId          String
  addressId         String
  status            OrderStatus   @default(PLACED)
  paymentMethod     PaymentMethod @default(COD)
  paymentStatus     String        @default("PENDING") // PENDING | PAID | FAILED (Razorpay later)
  itemTotal         Float
  deliveryFee       Float
  platformFee       Float
  tax               Float
  discount          Float         @default(0)
  grandTotal        Float
  couponCode        String?
  fulfillmentMode   String        @default("LOCAL_DELIVERY")
  invoiceRequired   Boolean       @default(false)
  buyerGstin        String?
  sellerGstin       String?
  deliveryPartner   String?
  riderLat          Float?
  riderLng          Float?
  estimatedDelivery DateTime?
  placedAt          DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  notes             String?
  idempotencyKey    String?
  requestHash       String?
  addressSnapshotJson String?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt])
  @@index([vendorId, status, placedAt])

  customer User      @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  address  Address   @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  productId           String
  productName         String
  productImage        String
  unitPrice           Float
  quantity            Int
  unitLabel           String?
  hsnCode             String?
  gstRate             Float?
  lineTax             Float       @default(0)
  selectedSize        String?
  specialInstructions String?
  isVeg               Boolean @default(true)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  message   String
  lat       Float?
  lng       Float?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Banner {
  id         String  @id @default(uuid())
  title      String
  subtitle   String
  imageUrl   String
  categoryId String?
  vendorId   String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  type          String // PERCENT | FLAT
  value         Float
  maxDiscount   Float?
  minOrder      Float    @default(0)
  isActive      Boolean  @default(true)
  description   String?
}

/// Seller applications reviewed by platform admin.
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CONTACTED
}

model SellerApplication {
  id             String            @id @default(uuid())
  vendorId       String?           @unique
  applicantName  String
  businessName   String
  phone          String
  email          String?
  city           String
  area           String?
  businessType   String
  premisesType   String?
  businessAddress String?
  pincode        String?
  gstin          String?
  pan            String?
  fssaiLicense   String?
  categoriesJson String @default("[]")
  documentsJson String @default("[]")
  acceptsWholesale Boolean @default(false)
  message        String?
  status         ApplicationStatus @default(PENDING)
  adminNotes     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

/// Separate activity trails for Buyer shop vs Seller dashboard.
enum ActivityMode {
  BUYER
  SELLER
  ADMIN
}

model ActivityLog {
  id        String       @id @default(uuid())
  userId    String?
  mode      ActivityMode
  action    String
  message   String?
  metaJson  String?
  createdAt DateTime     @default(now())

  @@index([mode, createdAt])
  @@index([userId, createdAt])
}
