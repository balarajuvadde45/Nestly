NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestly:nestly@localhost:5433/nestly?schema=public
JWT_SECRET=CHANGE_ME_to_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:8080
# Set the exact number of trusted reverse-proxy hops. Direct local requests use 0.
TRUST_PROXY_HOPS=0
DEFAULT_CITY=Hyderabad
LOG_LEVEL=info
# Required for real phone verification. No bypass codes are supported.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Online payments via Razorpay Payment Links. Leave blank for COD-only mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Platform commission on each delivered order, in percent (0-50). Sellers can
# override their own rate on the vendor record.
PLATFORM_COMMISSION_RATE=10
# Seller image uploads: folder to write to, and the public base URL serving it.
# Leave blank to use backend/uploads served from /media.
UPLOAD_DIR=
MEDIA_BASE_URL=
