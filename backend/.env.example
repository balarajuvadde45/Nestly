# ============================================================
# Nestly API — copy this file to .env and fill REAL values
#   copy:  cp .env.example .env   (or duplicate manually on Windows)
# Never commit .env to Git.
# ============================================================

NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL) — use ONE of the two styles ----

# Style A: full connection string (recommended)
# Local dev with Docker (`docker compose up -d`) uses host port 5433:
DATABASE_URL=postgresql://nestly:nestly@localhost:5433/nestly?schema=public
# Managed dev/prod DB (Render/Neon/Supabase) usually needs SSL, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public&sslmode=require

# Style B: separate fields (used only if DATABASE_URL is empty / still a placeholder)
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=nestly
# DB_PASSWORD=nestly
# DB_NAME=nestly
# DB_SCHEMA=public
# DB_SSL=false

# ---- Auth ----
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Optional: Google OAuth web client ID (for verifying idToken in production)
# GOOGLE_CLIENT_ID=

# ---- Cache / queue (wired in Phase 1) ----
REDIS_URL=redis://localhost:6379

# ---- Logging ----
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# ---- App ----
CORS_ORIGIN=*
DEFAULT_CITY=Hyderabad

# ---- Error tracking (Phase 0.7, optional) ----
# SENTRY_DSN=
