NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestly:nestly@localhost:5433/nestly?schema=public
JWT_SECRET=CHANGE_ME_to_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:8080
# Set the exact number of trusted reverse-proxy hops. Direct local requests use 0.
TRUST_PROXY_HOPS=0
DEFAULT_CITY=Hyderabad
LOG_LEVEL=info
# Required for real phone verification. No bypass codes are supported.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
